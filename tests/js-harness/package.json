{
  "name": "js-golden-harness",
  "private": true,
  "type": "module",
  "description": "Runs the original git-diff-view TS sources to generate golden fixtures for the C# port tests. Not shipped; dev-only.",
  "scripts": {
    "gen": "esbuild gen.ts --bundle --platform=node --format=cjs --outfile=gen.cjs --log-level=warning --alias:@git-diff-view/utils=./shims/utils.ts --alias:@git-diff-view/lowlight=./shims/lowlight.ts --external:@git-diff-view/core && node gen.cjs"
  },
  "dependencies": {
    "fast-diff": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "shiki": "^3.23.0"
  }
}
