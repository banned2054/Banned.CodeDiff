<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Banned.CodeDiff.Avalonia.Views;assembly=Banned.CodeDiff.Avalonia"
        xmlns:vm="clr-namespace:Banned.CodeDiff.Avalonia.Demo.ViewModels"
        x:Class="Banned.CodeDiff.Avalonia.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        RequestedThemeVariant="{Binding Theme}"
        Title="Banned.CodeDiff.Avalonia Demo"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding RenderCommand}" Content="渲染 diff" />
            <Button Command="{Binding LoadSampleCommand}" Content="载入示例" />
            <Button Command="{Binding LoadExpandableCommand}" Content="载入可展开示例" />
            <Button Command="{Binding LoadSyntaxSampleCommand}" Content="载入语法示例(cs/ts/json 循环)" />
            <Button Command="{Binding ExpandAllCommand}" Content="全部展开" IsEnabled="{Binding CanExpandHunks}" />
            <Button Command="{Binding CollapseAllCommand}" Content="全部收起" IsEnabled="{Binding CanExpandHunks}" />
            <ToggleButton Content="词级高亮" IsChecked="{Binding IsFastDiff}" />
            <ToggleButton Content="语法高亮" IsChecked="{Binding IsSyntax}" />
            <ToggleButton Content="Unified 视图" IsChecked="{Binding IsUnified}" />
            <ToggleButton Content="启用行选择" IsChecked="{Binding IsSelectionEnabled}" />
            <ToggleButton Content="深色主题" IsChecked="{Binding IsDark}" />
        </StackPanel>

        <TextBox Grid.Row="1"
                 MinHeight="140"
                 MaxHeight="200"
                 Margin="0,8"
                 AcceptsReturn="True"
                 Text="{Binding DiffText}"
                 TextWrapping="NoWrap"
                 PlaceholderText="粘贴 unified diff 文本" />

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1">
            <views:DiffView x:Name="DiffView"
                            DiffFile="{Binding DiffFile}"
                            IsSelectionEnabled="{Binding IsSelectionEnabled}"
                            SyntaxHighlight="{Binding IsSyntax}"
                            ViewMode="{Binding ViewMode}" />
        </Border>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding Stats}" />
        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Right"
                   Text="{Binding SelectionStatus}" />
    </Grid>
</Window>