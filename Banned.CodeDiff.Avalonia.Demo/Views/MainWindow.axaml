<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Banned.CodeDiff.Avalonia.Views;assembly=Banned.CodeDiff.Avalonia"
        xmlns:vm="clr-namespace:Banned.CodeDiff.Avalonia.Demo.ViewModels"
        x:Class="Banned.CodeDiff.Avalonia.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        RequestedThemeVariant="{Binding Theme}"
        Title="Banned.CodeDiff.Avalonia Demo"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen">
    <Window.KeyBindings>
        <!--Host-side shortcut wiring: the control ships no built-in key bindings by design.-->
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
    </Window.KeyBindings>
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding RenderCommand}" Content="渲染 diff" />
            <Button Command="{Binding LoadSampleCommand}" Content="载入示例" />
            <Button Command="{Binding LoadExpandableCommand}" Content="载入可展开示例" />
            <Button Command="{Binding LoadSyntaxSampleCommand}" Content="载入语法示例(cs/ts/json 循环)" />
            <Button Command="{Binding ExpandAllCommand}" Content="全部展开" IsEnabled="{Binding CanExpandHunks}" />
            <Button Command="{Binding CollapseAllCommand}" Content="全部收起" IsEnabled="{Binding CanExpandHunks}" />
            <ToggleButton Content="词级高亮" IsChecked="{Binding IsFastDiff}" />
            <ToggleButton Content="语法高亮" IsChecked="{Binding IsSyntax}" />
            <ToggleButton Content="Unified 视图" IsChecked="{Binding IsUnified}" />
            <ToggleButton Content="自动换行" IsChecked="{Binding IsWrap}" />
            <ToggleButton Content="单列行号" IsChecked="{Binding IsSingleNumberColumn}" />
            <ToggleButton Content="启用行选择" IsChecked="{Binding IsSelectionEnabled}" />
            <Button Command="{Binding CopySelectionCommand}" Content="复制选中行" />
            <Button Command="{Binding CopyOldFileCommand}" Content="复制旧文件" />
            <Button Command="{Binding CopyNewFileCommand}" Content="复制新文件" />
            <!-- The comment entry: bound straight to the control's explicit command — it is
                 enabled whenever a selection exists and raises DiffView.CommentRequested. -->
            <Button Command="{Binding #DiffView.BeginCommentCommand}" Content="添加评论" />
            <ToggleButton Content="深色主题" IsChecked="{Binding IsDark}" />
        </StackPanel>

        <TextBox Grid.Row="1"
                 MinHeight="140"
                 MaxHeight="200"
                 Margin="0,8"
                 AcceptsReturn="True"
                 Text="{Binding DiffText}"
                 TextWrapping="NoWrap"
                 PlaceholderText="粘贴 unified diff 文本" />

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1">
            <views:DiffView x:Name="DiffView"
                            Comments="{Binding Comments}"
                            DiffFile="{Binding DiffFile}"
                            FilePath="{Binding CurrentFilePath}"
                            IsSelectionEnabled="{Binding IsSelectionEnabled}"
                            SyntaxHighlight="{Binding IsSyntax}"
                            UseSingleLineNumberColumn="{Binding IsSingleNumberColumn}"
                            ViewMode="{Binding ViewMode}"
                            Wrap="{Binding IsWrap}" />
        </Border>

        <!-- Host-side comment editor: DiffView.CommentRequested (via code-behind) opens it, the
             host submits onto the anchor and hands the list back through DiffView.Comments. -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding IsCommentEditorOpen}">
            <TextBlock VerticalAlignment="Center" Text="{Binding CommentEditorTitle}" />
            <TextBox Width="420"
                     Text="{Binding CommentDraft}"
                     PlaceholderText="输入评论内容,提交后显示在锚定行下方" />
            <Button Command="{Binding SubmitCommentCommand}" Content="提交评论" />
            <Button Command="{Binding CancelCommentCommand}" Content="取消" />
            <Button Command="{Binding ClearCommentsCommand}" Content="清除全部评论" />
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding Stats}" />
        <TextBlock Grid.Row="4"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Right"
                   Text="{Binding SelectionStatus}" />
    </Grid>
</Window>