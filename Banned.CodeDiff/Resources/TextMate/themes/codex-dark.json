{
  "name": "Codex Dark (initial placeholder)",
  "type": "dark",
  "colors": { "editor.foreground": "#E3E3E0" },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#7C8287" } },
    { "scope": ["string"], "settings": { "foreground": "#A8C49E" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#C8A2C8" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#C8A2C8" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#C8A2C8" } },
    { "scope": ["keyword"], "settings": { "foreground": "#E0917F" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#E3E3E0" } },
    { "scope": ["storage"], "settings": { "foreground": "#E0917F" } },
    { "scope": ["storage.type"], "settings": { "foreground": "#E0917F" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#D7BA7D" } },
    { "scope": ["entity.name.class"], "settings": { "foreground": "#D7BA7D" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#A3B5D6" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#D7BA7D" } },
    { "scope": ["variable"], "settings": { "foreground": "#E3E3E0" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#E3E3E0" } },
    { "scope": ["support.function"], "settings": { "foreground": "#A3B5D6" } },
    { "scope": ["support.type"], "settings": { "foreground": "#D7BA7D" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#E3E3E0" } }
  ]
}
